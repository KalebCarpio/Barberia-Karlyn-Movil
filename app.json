{
  "expo": {
    "name": "Carlyn",
    "slug": "carlyn-mobile",
    "version": "1.0.0",
    "scheme": "carlyn",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barberiacarlyn.app"
    },
    "android": {
      "package": "com.barberiacarlyn.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EC",
        "foregroundImage": "./assets/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "0edba13b-6638-4596-aad7-b52090728837"
      }
    },
    "owner": "javi_10"
  }
}
